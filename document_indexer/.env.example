# Copy to .env and fill in only what you need.
# With nothing set, the indexer uses the offline fake embedder and a local
# JSON vector store.

# Force the offline backends even when the settings below are filled in:
# INDEXER_OFFLINE=1

# --- OpenAI (real embeddings) ---
# OPENAI_API_KEY=sk-...
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Postgres + pgvector (real vector store) ---
# Needs a running Postgres with the `vector` extension available on the server.
# The actual table is "<PG_TABLE>_<embedder>" (e.g. document_chunks_fake,
# document_chunks_openai) so each embedder gets its own; it and its HNSW index
# are created on first use.
# DATABASE_URL=postgresql:///siwes_rag
# PG_TABLE=document_chunks

# Points the Postgres integration tests at a database. Without it they skip.
# TEST_DATABASE_URL=postgresql:///siwes_rag

# --- Chunking ---
# CHUNK_SIZE=120
# CHUNK_OVERLAP=20

# --- Local store location (offline backend only) ---
# INDEX_PATH=document_indexer/data/index.json
